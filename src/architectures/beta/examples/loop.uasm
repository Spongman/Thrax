// Loop Counter
// Print the numbers 1 through 5.

.include "beta.uasm"
.options tty

	CMOVE(stack, SP)
	CMOVE(1, R1)            // counter = 1

loop:
	CMPEQC(R1, 6, R2)       // if counter == 6, exit
	BT(R2, done)

	// Print counter
	PUSH(R1)
	CALL(print_decimal, 1)

	// Print space
	CMOVE(' ', R0)
	WRCHAR()

	// Increment and loop
	ADDC(R1, 1, R1)
	BR(loop)

done:
	// Print newline
	CMOVE('\n', R0)
	WRCHAR()
	HALT()

// print_decimal(n): write n >= 0 in decimal, leading digits first.
print_decimal:
	PUSH(LP) PUSH(BP)
	MOVE(SP, BP)
	PUSH(R0) PUSH(R1)
	LD(BP, -12, R1)         // R1 <- n
	DIVC(R1, 10, R0)        // R0 <- n / 10, the leading digits
	BEQ(R0, pd_digit)
	PUSH(R0)
	CALL(print_decimal, 1)
pd_digit:
	MULC(R0, 10, R0)        // R0 <- n % 10, the last digit
	SUB(R1, R0, R0)
	ADDC(R0, '0', R0)
	WRCHAR()
	POP(R1) POP(R0)
	MOVE(BP, SP)
	POP(BP) POP(LP)
	RTN()

stack: STORAGE(64)
