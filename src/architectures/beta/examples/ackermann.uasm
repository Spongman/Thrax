// Ackermann
// Compute A(3, 3) = 61 by recursion; each call pushes a frame, so the stack fills up.

.include "beta.uasm"
.options tty

	CMOVE(stack, SP)
	CMOVE(prompt, R1)       // print the label
	PUSH(R1)
	CALL(print_string, 1)

	CMOVE(3, R1)            // ackermann(3, 3)
	PUSH(R1)                // n
	PUSH(R1)                // m
	CALL(ackermann, 2)

	PUSH(R0)                // print the result
	CALL(print_decimal, 1)
	HALT()

prompt: .text "A(3, 3) = "

// ackermann(m, n): A(m, n) in R0.
//   A(0, n) = n + 1
//   A(m, 0) = A(m - 1, 1)
//   A(m, n) = A(m - 1, A(m, n - 1))
ackermann:
	PUSH(LP) PUSH(BP)
	MOVE(SP, BP)
	PUSH(R1) PUSH(R2)
	LD(BP, -12, R1)         // R1 <- m
	LD(BP, -16, R2)         // R2 <- n

	BNE(R1, m_positive)
	ADDC(R2, 1, R0)         // m = 0: A(0, n) = n + 1
	BR(ackermann_return)

m_positive:
	BNE(R2, both_positive)
	CMOVE(1, R0)            // n = 0: A(m, 0) = A(m - 1, 1)
	PUSH(R0)
	SUBC(R1, 1, R0)
	PUSH(R0)
	CALL(ackermann, 2)
	BR(ackermann_return)

both_positive:
	SUBC(R2, 1, R0)         // inner call: A(m, n - 1)
	PUSH(R0)
	PUSH(R1)
	CALL(ackermann, 2)

	PUSH(R0)                // outer call: A(m - 1, inner)
	SUBC(R1, 1, R0)
	PUSH(R0)
	CALL(ackermann, 2)

ackermann_return:
	POP(R2) POP(R1)
	MOVE(BP, SP)
	POP(BP) POP(LP)
	RTN()

// print_string(s): write the zero-terminated string at address s.
print_string:
	PUSH(LP) PUSH(BP)
	MOVE(SP, BP)
	PUSH(R0) PUSH(R1) PUSH(R2) PUSH(R3)
	LD(BP, -12, R1)         // R1 <- address of the next character
ps_next:
	ANDC(R1, -4, R3)        // loads are whole words, so fetch the word holding it
	LD(R3, 0, R0)
	ANDC(R1, 3, R2)         // and shift its byte down; words are little-endian
	SHLC(R2, 3, R2)
	SHR(R0, R2, R0)
	ANDC(R0, 0xFF, R0)
	BEQ(R0, ps_done)        // stop at the terminating zero
	WRCHAR()
	ADDC(R1, 1, R1)
	BR(ps_next)
ps_done:
	POP(R3) POP(R2) POP(R1) POP(R0)
	MOVE(BP, SP)
	POP(BP) POP(LP)
	RTN()

// print_decimal(n): write n >= 0 in decimal, leading digits first.
print_decimal:
	PUSH(LP) PUSH(BP)
	MOVE(SP, BP)
	PUSH(R0) PUSH(R1)
	LD(BP, -12, R1)         // R1 <- n
	DIVC(R1, 10, R0)        // R0 <- n / 10, the leading digits
	BEQ(R0, pd_digit)
	PUSH(R0)
	CALL(print_decimal, 1)
pd_digit:
	MULC(R0, 10, R0)        // R0 <- n % 10, the last digit
	SUB(R1, R0, R0)
	ADDC(R0, '0', R0)
	WRCHAR()
	POP(R1) POP(R0)
	MOVE(BP, SP)
	POP(BP) POP(LP)
	RTN()

stack: STORAGE(1024)
