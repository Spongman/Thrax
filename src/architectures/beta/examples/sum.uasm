// Sum of Numbers
// Compute 5 + 3 = 8 and print it.

.include "beta.uasm"
.options tty

	CMOVE(stack, SP)

	// Load values
	CMOVE(5, R1)            // R1 <- 5
	CMOVE(3, R2)            // R2 <- 3

	// Add them
	ADD(R1, R2, R3)         // R3 <- R1 + R2 = 8

	// Print result
	PUSH(R3)
	CALL(print_decimal, 1)

	// Print newline
	CMOVE('\n', R0)
	WRCHAR()

	HALT()

// print_decimal(n): write n >= 0 in decimal, leading digits first.
print_decimal:
	PUSH(LP) PUSH(BP)
	MOVE(SP, BP)
	PUSH(R0) PUSH(R1)
	LD(BP, -12, R1)         // R1 <- n
	DIVC(R1, 10, R0)        // R0 <- n / 10, the leading digits
	BEQ(R0, pd_digit)
	PUSH(R0)
	CALL(print_decimal, 1)
pd_digit:
	MULC(R0, 10, R0)        // R0 <- n % 10, the last digit
	SUB(R1, R0, R0)
	ADDC(R0, '0', R0)
	WRCHAR()
	POP(R1) POP(R0)
	MOVE(BP, SP)
	POP(BP) POP(LP)
	RTN()

stack: STORAGE(64)
